# ─── Local development ─────────────────────────────────────────────────────────
# iOS Simulator (API on this Mac)
EXPO_PUBLIC_API_URL=http://localhost:8000

# Physical iPhone / iPad on the same Wi-Fi — use your Mac's LAN IP, NOT localhost
# Find IP: ipconfig getifaddr en0   (or System Settings → Network)
# EXPO_PUBLIC_API_URL=http://192.168.1.42:8000

# Android emulator
# EXPO_PUBLIC_API_URL=http://10.0.2.2:8000

# Studio web app — OAuth / integrations open in the device browser
# Simulator: http://localhost:3000 won't work on a phone; use LAN IP there too
# EXPO_PUBLIC_WEB_URL=http://192.168.1.42:3000

# ─── EAS preview / production (Expo dashboard → Environment variables) ───────
# EXPO_PUBLIC_API_URL=https://api.yourdomain.com
# EXPO_PUBLIC_WEB_URL=https://app.yourdomain.com
# EAS_PROJECT_ID=          # set by `eas init` → app.json extra.eas.projectId
# EXPO_OWNER=your-expo-account
