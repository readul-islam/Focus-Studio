# Copy to .env and fill in real values. Never commit .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- URLs ---
FRONTEND_URL=http://localhost:3000
CLIENT_PORTAL_URL=http://localhost:3001
CONTRACTOR_PORTAL_URL=http://localhost:3002
CORS_ALLOWED_ORIGINS=http://localhost:3000
# Production cookie domain for api + app subdomains (leading dot)
# AUTH_COOKIE_DOMAIN=.focuspilot.io

# Email logo URL (defaults to FRONTEND_URL/brand/email_logo.png)
# EMAIL_LOGO_URL=https://focuspilot.io/brand/email_logo.png
# Fallback CDN logo if primary fails to load in email clients
# EMAIL_LOGO_FALLBACK_URL=https://i.ibb.co/BVqBTSJx/email-logo.png

# --- Database (optional; defaults to SQLite locally) ---
# DATABASE_URL=postgres://user:password@localhost:5432/techstyles

# --- AWS S3 (file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=techstyles
AWS_S3_REGION_NAME=eu-west-2

# --- Email (Gmail SMTP fallback) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Resend (preferred for transactional mail when set)
RESEND_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=

# --- Xero ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SCOPE=offline_access accounting.transactions accounting.contacts
XERO_REDIRECT_URI=http://localhost:8000/xero/xero/callback/

# --- Gmail OAuth ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://127.0.0.1:8000/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar

# --- Vexa (meetings) ---
VEXA_API_KEY=
VEXA_API_BASE=https://gateway.vexa.ai

# --- Stripe (SaaS billing) — https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_TRIAL_DAYS=14
