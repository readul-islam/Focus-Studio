# Copy to .env and fill in real values. Never commit .env.

# --- Django core ---
SECRET_KEY=change-me-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# --- URLs ---
FRONTEND_URL=http://localhost:3000
MARKETING_URL=http://localhost:3005
# Optional override; defaults to {MARKETING_URL}/studio
# PUBLIC_PROFILE_BASE_URL=http://localhost:3005/studio
CLIENT_PORTAL_URL=http://localhost:3001
CONTRACTOR_PORTAL_URL=http://localhost:3002
# Comma-separated; include marketing + studio + portals in production
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3005,http://localhost:3001,http://localhost:3002
# Production cookie domain for api + app + www subdomains (leading dot)
# AUTH_COOKIE_DOMAIN=.focuspilot.io
# CORS_ALLOWED_ORIGINS=https://focuspilot.io,https://www.focuspilot.io,https://app.focuspilot.io,https://clients.focuspilot.io,https://contractors.focuspilot.io

# Email logo URL (defaults to https://focuspilot.io/public/brand/email_logo.png)
EMAIL_LOGO_URL=https://focuspilot.io/public/brand/email_logo.png

# --- Database (optional; defaults to SQLite locally) ---
# DATABASE_URL=postgres://user:password@localhost:5432/techstyles

# --- AWS S3 (file storage) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=techstyles
AWS_S3_REGION_NAME=eu-west-2

# --- Email (Gmail SMTP fallback) ---
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=

# Resend (preferred for transactional mail when set)
RESEND_API_KEY=

# --- OpenAI ---
OPENAI_API_KEY=
# Required for Design tab (vision + DALL-E image generation) and other AI features

# --- Meshy (Design tab 3D) ---
# Free test key — no credits consumed; returns sample GLB for integration testing
MESHY_API_KEY=msy_dummy_api_key_for_test_mode_12345678
# Production: create key at https://www.meshy.ai/settings/api

# --- Xero ---
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_SCOPE=offline_access accounting.transactions accounting.contacts
XERO_REDIRECT_URI=http://localhost:8000/xero/xero/callback/

# --- Notion OAuth (studio workspace) ---
NOTION_CLIENT_ID=
NOTION_CLIENT_SECRET=
NOTION_REDIRECT_URI=http://localhost:8000/notion/callback/

# --- Gmail OAuth (in-app Gmail/Calendar integration) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=http://localhost:8000/gmail/callback
GMAIL_SCOPES=https://www.googleapis.com/auth/gmail.modify https://www.googleapis.com/auth/calendar

# --- Google Sign-In (landing signup/login) ---
# Optional: use separate OAuth client; otherwise GMAIL_* values are reused automatically.
# GOOGLE_AUTH_CLIENT_ID=
# GOOGLE_AUTH_CLIENT_SECRET=
GOOGLE_AUTH_REDIRECT_URI=http://localhost:8000/user/google/callback/
# GOOGLE_AUTH_SCOPES=openid email profile

# --- Vexa (meetings) ---
VEXA_API_KEY=
VEXA_API_BASE=https://gateway.vexa.ai

# --- Stripe (SaaS billing) — https://dashboard.stripe.com/test/apikeys ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_TRIAL_DAYS=14
