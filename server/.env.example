# If set, transactional mail (invites, OTP, etc.) is sent via Resend instead of Gmail SMTP.
# Verify your domain in Resend and use a from-address on that domain (see DEFAULT_FROM_EMAIL).
RESEND_API_KEY=re_your_api_key_here

# Stripe (SaaS billing) — https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Price IDs from Stripe Products (recurring monthly prices)
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_PROFESSIONAL=price_...
STRIPE_PRICE_ENTERPRISE=price_...
STRIPE_TRIAL_DAYS=14
FRONTEND_URL=http://localhost:3000
